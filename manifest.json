{
  "manifest_version": 3,
  "name": "TT Paywall Breaker",
  "version": "1.1.0",
  "description": "Damit kannst du auch TT-Artikel hinter der Paywall lesen.",
  "minimum_chrome_version": "111",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TT Paywall Breaker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}